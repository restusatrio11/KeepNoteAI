# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# NextAuth / Auth.js
AUTH_SECRET=your_auth_secret_here
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenRouter AI
OPENROUTER_API_KEY=your_openrouter_api_key_here
AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
AI_VISION_MODEL=google/gemini-2.0-flash-lite-preview-02-05:free
AI_AUDIO_MODEL=google/gemini-2.5-flash-lite

# Browserless (Puppeteer e-Kinerja Sync)
BROWSERLESS_URL=wss://chrome.browserless.io?token=your_token

# Google Drive OAuth (Opsional, per-user storage)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback

# Telegram Bot (Opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=KipappAIbot
