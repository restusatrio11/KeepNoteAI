# Salin file ini menjadi `.env` dan isi DATABASE_URL dengan connection string Neon
# yang SAMA dengan web app. File `.env` dibaca otomatis oleh desktop saat startup,
# sehingga end-user TIDAK perlu mengisi Database URL — cukup login seperti di web.
#
# Penempatan:
#   - Mode dev : di folder desktop/ (.env)
#   - Mode build: di samping KeepNoteAI-Desktop.exe (hasil npm run pack)
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# URL web KeepNoteAI (buka di browser dari tombol "Buka Web" / "Daftar di web").
SITE_URL=https://keepnoteai.vercel.app
